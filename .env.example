# Non-secret production configuration for /etc/music-agent/music-agent.env.
# Secrets belong in /etc/music-agent/credentials and are injected by systemd.
MUSIC_AGENT_ENVIRONMENT=production
MUSIC_AGENT_BIND_HOST=0.0.0.0
MUSIC_AGENT_BIND_PORT=8787
MUSIC_AGENT_HTTPS_ENABLED=false
MUSIC_AGENT_DATABASE_PATH=/var/lib/music-agent/music-agent.db
MUSIC_AGENT_ARTWORK_PATH=/var/lib/music-agent/artwork
MUSIC_AGENT_DOWNLOADS_PATH=/srv/music-downloads
MUSIC_AGENT_MUSIC_PATH=/srv/music
MUSIC_AGENT_BACKUP_PATH=/var/lib/music-agent/backups
MUSIC_AGENT_ALLOWED_CLIENT_CIDRS=127.0.0.0/8,::1/128,192.168.50.0/24,100.64.0.0/10,fd7a:115c:a1e0::/48
MUSIC_AGENT_TRUSTED_HOSTS=localhost,127.0.0.1,[::1],music-server
MUSIC_AGENT_TRUSTED_PROXY_CIDRS=
MUSIC_AGENT_SESSION_IDLE_SECONDS=86400
MUSIC_AGENT_SESSION_ABSOLUTE_SECONDS=2592000
MUSIC_AGENT_AUTH_WINDOW_SECONDS=900
MUSIC_AGENT_AUTH_MAX_FAILURES=8
MUSIC_AGENT_AUTH_BLOCK_SECONDS=900
MUSIC_AGENT_OPENAI_MODEL=gpt-5.4-mini
MUSIC_AGENT_OPENAI_REASONING_EFFORT=low
MUSIC_AGENT_OPENAI_WEB_SEARCH_ENABLED=false
MUSIC_AGENT_MAX_AGENT_STEPS=10
MUSIC_AGENT_MAX_AGENT_SECONDS=120
MUSIC_AGENT_OPENAI_MAX_OUTPUT_TOKENS=12000
MUSIC_AGENT_MAX_CANDIDATES_PER_REQUEST=250
MUSIC_AGENT_LISTENBRAINZ_USERNAME=
# REQUIRED: replace CHANGE-ME before install can activate the service.
# MusicBrainz requires a meaningful application/version and operator contact.
MUSIC_AGENT_MUSICBRAINZ_USER_AGENT=MusicAgent/0.1 (+mailto:CHANGE-ME@example.invalid)
MUSIC_AGENT_APPLE_METADATA_ENABLED=false
MUSIC_AGENT_APPLE_STOREFRONT=GB
MUSIC_AGENT_MAX_DIRECT_MEDIA_SECONDS=1800
MUSIC_AGENT_ALLOW_LOSSY_TRANSCODE=false
MUSIC_AGENT_WORKER_DOWNLOAD_SLOTS=2
MUSIC_AGENT_LEASE_SECONDS=120
MUSIC_AGENT_MIN_FREE_BYTES=5368709120
MUSIC_AGENT_INITIAL_SCAN_REQUIRED=true
MUSIC_AGENT_LOG_LEVEL=INFO
# Optional usage estimates. Leave every required component unset to display
# "not configured" instead of an inaccurate cost.
# MUSIC_AGENT_PRICE_INPUT_PER_MILLION_USD=
# MUSIC_AGENT_PRICE_CACHED_INPUT_PER_MILLION_USD=
# MUSIC_AGENT_PRICE_CACHE_WRITE_PER_MILLION_USD=
# MUSIC_AGENT_PRICE_OUTPUT_PER_MILLION_USD=
# MUSIC_AGENT_PRICE_WEB_SEARCH_LOW_USD=
# MUSIC_AGENT_PRICE_WEB_SEARCH_MEDIUM_USD=
# MUSIC_AGENT_PRICE_WEB_SEARCH_HIGH_USD=
