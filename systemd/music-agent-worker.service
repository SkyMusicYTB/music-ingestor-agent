[Unit]
Description=Music Agent persistent job worker
Documentation=file:/opt/music-agent/current/docs/operations.md
Wants=network-online.target
After=network-online.target local-fs.target
RequiresMountsFor=/var/lib/music-agent /srv/music-downloads /srv/music
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
User=music-agent
Group=music-agent
WorkingDirectory=/var/lib/music-agent
EnvironmentFile=/etc/music-agent/music-agent.env
Environment=PATH=/opt/music-agent/tools/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/var/lib/music-agent
Environment=TMPDIR=/srv/music-downloads/.tmp
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MUSIC_AGENT_SERVICE_ROLE=worker
ExecStart=/opt/music-agent/current/venv/bin/music-agent-worker
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=180s
KillSignal=SIGTERM
KillMode=mixed
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/music-agent /var/lib/music-agent/artwork /srv/music-downloads /srv/music
ReadOnlyPaths=/etc/music-agent /var/lib/music-agent/backups /var/lib/music-agent/deployments
TasksMax=512

[Install]
WantedBy=multi-user.target
